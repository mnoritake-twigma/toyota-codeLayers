{
  "name": "lumiere-test-drive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0 <21"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "lint": "eslint . && npm run lint:ds && npm run lint:assets",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "seed:export": "node --import tsx scripts/export-seed.ts",
    "tokens": "node --import tsx scripts/build-tokens.ts",
    "lint:ds": "node --import tsx scripts/check-ds.ts",
    "lint:assets": "node --import tsx scripts/check-assets.ts",
    "check:code-connect": "node --import tsx scripts/check-code-connect.ts",
    "figma:parse": "figma connect parse --skip-update-check --exit-on-unreadable-files"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@figma/code-connect": "^2.0.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.22.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.3",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.26.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
